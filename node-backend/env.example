# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Database
DATABASE_URL="mysql://user:password@localhost:3306/hushryd"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Backend Public URL (for PayU callbacks and webhooks)
# For local dev with ngrok: https://your-ngrok-url.ngrok.io
# For production: https://api.yourdomain.com
BACKEND_PUBLIC_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=support@hushryd.com

# AWS S3 (File Storage)
# Required for document uploads (KYC, vehicle photos, invoices)
# Get credentials from: AWS Console > IAM > Users > Security credentials > Create access key
# Create S3 bucket: AWS Console > S3 > Create bucket
# See AWS_S3_SETUP.md for detailed setup instructions
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hushryd-documents

# Firebase (FCM Push Notifications - Mobile Apps)
# Option 1: Provide JSON string directly (escape quotes and newlines)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}
# Option 2: Provide path to JSON file (relative to backend folder) - RECOMMENDED
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Note: Download service account key from Firebase Console > Project Settings > Service Accounts
# Place the JSON file in the backend/ folder and name it firebase-service-account.json

# Web Push (VAPID Keys - Web Browsers)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Or use online tool: https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@hushryd.com

# Redis (Caching)
# Option 1: Full Redis URL (Recommended)
REDIS_URL=redis://localhost:6379
# Option 2: Individual components
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin
ADMIN_EMAIL=admin@hushryd.com
ADMIN_PASSWORD=admin123

# PayU (Payment Gateway)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_MODE=TEST

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

