# Backend API Configuration
# Copy this file to .env and update with your values
# The .env file is gitignored and won't be committed to version control

# Backend API Base URL
# For Android Emulator: http://10.0.2.2:3000/api
# For Android Physical Device: http://YOUR_LOCAL_IP:3000/api (find IP with: ip addr show or ifconfig)
# For iOS Simulator: http://localhost:3000/api
# For Production: https://api.hushryd.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Google Maps API Key (optional - can also be set in app.json)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
